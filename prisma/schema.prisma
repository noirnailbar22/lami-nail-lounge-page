// Trợ lý Realtor — database schema.
// Follow Up Boss vẫn là nơi quản lý hồ sơ khách chính. Ở đây chỉ lưu bản sao tối thiểu
// cần cho assistant (khóa theo fubId để không tạo trùng) và dữ liệu riêng của app.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Cài đặt & nhật ký ----------

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ActionLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actor      String   @default("user") // user | system | ai
  action     String // vd. draft.approve, sms.mark_manual, fub.note.create
  entityType String?
  entityId   String?
  result     String   @default("ok") // ok | blocked | error
  details    Json?

  @@index([at])
  @@index([entityType, entityId])
}

model SyncRun {
  id         String    @id @default(cuid())
  provider   String // fub | demo
  kind       String // people | interactions | tasks | webhook
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("running") // running | ok | error
  created    Int       @default(0)
  updated    Int       @default(0)
  skipped    Int       @default(0)
  error      String?
}

model WebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  event       String
  uri         String?
  resourceIds Json?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?
}

model OAuthCredential {
  id               String    @id @default(cuid())
  provider         String // google
  accountEmail     String
  scopes           String
  accessTokenEnc   String
  refreshTokenEnc  String?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([provider, accountEmail])
}

// ---------- Khách hàng (bản sao tối thiểu từ FUB/demo) ----------

model Client {
  id             String    @id @default(cuid())
  source         String // fub | demo
  fubId          Int?      @unique
  isDemo         Boolean   @default(false)
  name           String
  firstName      String?
  lastName       String?
  emails         Json      @default("[]") // [{value,type,status,isPrimary}]
  phones         Json      @default("[]")
  stage          String?
  sourceLabel    String? // nguồn lead trong FUB
  assignedTo     String?
  assignedUserId Int?
  price          Int?
  tags           Json      @default("[]")
  needs          Json      @default("{}") // ngân sách, khu vực, loại nhà... (xem lib/clients/needs.ts)
  lastActivityAt DateTime?
  remoteUpdated  DateTime? // trường "updated" của FUB — dùng để không ghi đè bằng bản cũ
  syncedAt       DateTime?
  smsOptOut      Boolean   @default(false)
  emailOptOut    Boolean   @default(false)
  optOutNote     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  interactions Interaction[]
  drafts       Draft[]
  saved        SavedProperty[]
  tasks        CrmTask[]
  proposals    CrmProposal[]
  searches     SearchRequest[]

  @@index([stage])
  @@index([lastActivityAt])
}

model Interaction {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  source     String // fub | demo | app
  externalId String? // id bên FUB (vd. note:123)
  kind       String // note | call | text | email | event | appointment | showing
  direction  String? // in | out
  occurredAt DateTime
  subject    String?
  body       String?
  isDemo     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([source, externalId])
  @@index([clientId, occurredAt])
}

model CrmTask {
  id          String    @id @default(cuid())
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  source      String // fub | demo | app
  fubId       Int?      @unique
  name        String
  type        String?
  dueAt       DateTime?
  isCompleted Boolean   @default(false)
  isDemo      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Đề xuất ghi vào CRM (note / task / cập nhật) — chỉ ghi khi người dùng duyệt.
model CrmProposal {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind       String // note | task | needs_update
  payload    Json
  rationale  String?
  status     String    @default("proposed") // proposed | approved | applied | rejected | failed
  target     String // fub | demo
  result     Json?
  error      String?
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?
  appliedAt  DateTime?
}

// ---------- Giọng văn ----------

model StyleProfile {
  id        String   @id @default(cuid())
  version   Int      @unique
  isActive  Boolean  @default(false)
  data      Json // xem lib/style/schema.ts
  note      String?
  createdAt DateTime @default(now())
}

model StyleSample {
  id        String   @id @default(cuid())
  channel   String // sms | email
  language  String   @default("en")
  label     String   @default("good") // good | bad
  text      String
  origin    String   @default("pasted") // pasted | edited_draft
  draftId   String?
  createdAt DateTime @default(now())
}

// ---------- Bản nháp & gửi ----------

model Draft {
  id                String    @id @default(cuid())
  clientId          String
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scenario          String // new_lead | no_reply | post_showing | send_homes | pre_offer | past_client
  channel           String // sms | email
  language          String    @default("en")
  recipientName     String?
  recipientAddress  String? // số điện thoại hoặc email
  subject           String?
  body              String
  originalBody      String? // bản AI/mẫu ban đầu, để so sánh
  status            String    @default("draft") // xem lib/drafts/state.ts
  generator         String // ai | demo_template
  isDemo            Boolean   @default(false)
  missingInfo       Json      @default("[]")
  factsUsed         Json      @default("[]")
  warnings          Json      @default("[]")
  styleVersion      Int?
  threadId          String?
  propertyIds       Json      @default("[]")
  approvedHash      String?
  approvedAt        DateTime?
  sentAt            DateTime?
  providerMessageId String?
  sendError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  attempts SendAttempt[]

  @@index([status])
}

model SendAttempt {
  id                String   @id @default(cuid())
  draftId           String
  draft             Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  idempotencyKey    String   @unique // hash(draftId + approvedHash) — một nội dung duyệt = tối đa một lần gửi
  channel           String
  provider          String // gmail | demo_email | fub_manual
  recipient         String
  subject           String?
  body              String
  status            String // pending | sent | failed | unknown | manual_required
  providerMessageId String?
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ---------- Nhà ----------

model Property {
  id            String    @id @default(cuid())
  source        String // csv | manual | link | demo | mls
  sourceRef     String? // tên file CSV, MLS#...
  sourceUrl     String?
  fetchedAt     DateTime  @default(now())
  isDemo        Boolean   @default(false)
  address       String
  city          String?
  state         String?
  zip           String?
  subdivision   String?
  lat           Float?
  lng           Float?
  propertyType  String? // single_family | condo | townhome | multi_family | land
  status        String? // active | pending | sold | off_market | unknown
  listPrice     Int?
  listDate      DateTime?
  pendingPrice  Int?
  soldPrice     Int?
  soldDate      DateTime?
  estimatePrice Int? // ước tính tự động của bên thứ ba — KHÔNG dùng như giá sold
  estimateSource String?
  beds          Float?
  baths         Float?
  sqft          Int?
  lotSqft       Int?
  yearBuilt     Int?
  garageSpaces  Int?
  pool          Boolean?
  stories       Int?
  condition     String? // poor | fair | average | good | excellent
  remodeled     Boolean?
  remodelYear   Int?
  hoaMonthly    Int?
  daysOnMarket  Int?
  priceReduced  Boolean?
  description   String?
  conflicts     Json      @default("[]") // xung đột giữa các nguồn khi nhập
  raw           Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  saved SavedProperty[]

  @@index([zip])
  @@index([status])
}

model SavedProperty {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  note       String?
  fit        Json?
  createdAt  DateTime @default(now())

  @@unique([clientId, propertyId])
}

model SearchRequest {
  id        String   @id @default(cuid())
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  rawText   String
  filters   Json
  parser    String // ai | demo_rules
  warnings  Json     @default("[]")
  createdAt DateTime @default(now())
}

// ---------- Comps ----------

model CompRuleSet {
  id         String    @id @default(cuid())
  version    Int       @unique
  status     String    @default("draft") // proposed | active | archived
  name       String
  rules      Json // xem lib/comps/rules.ts
  rationale  String?
  origin     String    @default("manual") // manual | from_examples
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
}

model CompExample {
  id         String   @id @default(cuid())
  title      String
  subject    Json
  comps      Json // [{address, selected, reason, adjustments:[{label,amount}], soldPrice,...}]
  finalLow   Int?
  finalHigh  Int?
  notes      String?
  createdAt  DateTime @default(now())
}

model CompReport {
  id             String   @id @default(cuid())
  title          String
  subjectId      String
  selections     Json // [{propertyId, included, excludeReason, adjustmentOverrides}]
  ruleSetId      String?
  ruleVersion    Int?
  result         Json? // snapshot tính toán khi lưu
  notes          String?
  isDemo         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
