# Sao chép thành .env và điền giá trị. KHÔNG commit file .env.

# --- Database ---
# Local: npm run db:start chạy Postgres ở cổng 5433.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/realtor"

# --- Chế độ ---
# true = luôn dùng dữ liệu demo hư cấu, kể cả khi có key thật.
DEMO_MODE="true"

# --- Đăng nhập (bắt buộc khi chạy online) ---
# Mật khẩu đăng nhập app. Để trống ở local = không yêu cầu đăng nhập (chỉ cho máy cá nhân).
APP_PASSWORD=""
# Chuỗi ngẫu nhiên >= 32 ký tự để ký cookie phiên: openssl rand -base64 48
SESSION_SECRET=""
# Khóa mã hóa token OAuth (32 byte base64): openssl rand -base64 32
ENCRYPTION_KEY=""

# --- Anthropic (AI) ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# --- Follow Up Boss ---
FUB_API_KEY=""
# Tên hệ thống và key do FUB cấp khi đăng ký tích hợp (https://docs.followupboss.com/reference/identification)
FUB_SYSTEM_NAME="RealtorAssistant"
FUB_SYSTEM_KEY=""
# Bí mật ngẫu nhiên đặt trong URL webhook để nhận diện (không phải API key)
FUB_WEBHOOK_TOKEN=""

# --- Gmail / Google Workspace (OAuth) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# vd. http://localhost:3000/api/email/google/callback
GOOGLE_REDIRECT_URI="http://localhost:3000/api/email/google/callback"

# --- Chữ ký tin nhắn ---
SIGNATURE_NAME="Hiep"
SIGNATURE_COMPANY="Win Nguyen Group"
SIGNATURE_PHONE="(512) 456-3993"
SIGNATURE_EMAIL="hiep@winnguyengroup.com"
